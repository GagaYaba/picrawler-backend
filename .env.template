# Copy to .env and fill in locally. Never commit .env.
# Robot implementation used by the API: "simulated" or "real".
ROBOT_MODE=simulated
# Operator token required by every API route except /health (at least 32 characters).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Seconds without heartbeat before the robot is put in the sitting position (hypothesis: 2).
HEARTBEAT_TIMEOUT_S=2
# Browser origins allowed to call the API, comma separated (for example the console in development).
# Empty: no browser origin is allowed. Never use *.
CORS_ORIGINS=http://localhost:5173
